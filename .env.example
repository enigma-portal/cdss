# Standalone ingestion CLI settings. Dashboard connectors are configured separately
# in Admin > SIEM connections and encrypted using data/connector.key.
# Never commit credentials or data/*.key. Back up keys securely with the database.
WAZUH_INDEXER_URL=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USERNAME=cdss_reader
WAZUH_INDEXER_PASSWORD=replace-with-a-secret
WAZUH_INDEXER_INDEX=wazuh-alerts-*
# Keep true in production. Set false only for a lab using a self-signed certificate.
WAZUH_INDEXER_VERIFY_TLS=true

# Normally leave empty. Supply a CA certificate bundle only when your network
# uses a trusted inspection proxy or a custom certificate authority.
MITRE_TAXII_CA_BUNDLE=

# Realtime polling is repeat-safe because Wazuh alert IDs are de-duplicated.
CDSS_REALTIME_ENABLED=true
# Analyst-facing repeated-alert grouping window (minutes); not incident correlation.
CDSS_ALERT_GROUP_WINDOW_MINUTES=60
# Grouped-alert archive retrieval: first/last event +/- buffer, capped per run.
CDSS_INVESTIGATION_EVIDENCE_BUFFER_MINUTES=10
CDSS_INVESTIGATION_MAX_ARCHIVE_EVENTS=200
# Poll interval/batch/minimum severity, session timeout and the 15-minute
# correlation window are persisted in SQLite system_settings, managed by Admin.
# SQLite location: data/cdss.db (app/database/__init__.py).
# Flask secret: locally generated data/session.key; never share or commit it.
# Local development binding: 127.0.0.1:5000. Enable secure cookies behind HTTPS.
CDSS_HTTPS_ENABLED=false
# Optional official Enterprise ATT&CK STIX JSON file for catalogue bootstrap.
MITRE_ENTERPRISE_STIX_FILE=
