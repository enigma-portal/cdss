# Copy these values into your own environment. Never commit real credentials.
WAZUH_INDEXER_URL=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USERNAME=cdss_reader
WAZUH_INDEXER_PASSWORD=replace-with-a-secret
WAZUH_INDEXER_INDEX=wazuh-alerts-*
# Keep true in production. Set false only for a lab using a self-signed certificate.
WAZUH_INDEXER_VERIFY_TLS=true

# Normally leave empty. Supply a CA certificate bundle only when your network
# uses a trusted inspection proxy or a custom certificate authority.
MITRE_TAXII_CA_BUNDLE=

# Realtime polling is repeat-safe because Wazuh alert IDs are de-duplicated.
CDSS_REALTIME_ENABLED=true
CDSS_POLL_INTERVAL_SECONDS=30
CDSS_POLL_BATCH_SIZE=100
CDSS_PORT=5001
